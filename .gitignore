# Capacitor: the generated native project. Pods and build output are
# regenerated by `npx cap sync`; the ios/App/App folder is hand-edited and IS
# committed once it exists.
ios/App/Pods/
ios/App/build/
ios/App/App/public/
DerivedData/
*.xcuserstate
